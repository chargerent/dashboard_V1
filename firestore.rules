rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.username == 'chargerent'
      );
    }

    function hasClientScope() {
      return request.auth != null && request.auth.token.clientId is string &&
        request.auth.token.clientId.size() > 0;
    }

    function isPartner() {
      return request.auth != null && request.auth.token.role == 'partner';
    }

    function canReadKioskData(data) {
      return isAdmin() || (hasClientScope() && data.info is map && (
        (isPartner() && data.info.rep in [
          request.auth.token.clientId,
          request.auth.token.clientId.lower(),
          request.auth.token.clientId.upper()
        ]) ||
        (!isPartner() && data.info.client in [
          request.auth.token.clientId,
          request.auth.token.clientId.lower(),
          request.auth.token.clientId.upper()
        ])
      ));
    }

    function canReadKioskAccess(data) {
      return isAdmin() || (hasClientScope() && data is map && (
        (isPartner() && data.repId in [
          request.auth.token.clientId,
          request.auth.token.clientId.lower(),
          request.auth.token.clientId.upper()
        ]) ||
        (!isPartner() && data.clientId in [
          request.auth.token.clientId,
          request.auth.token.clientId.lower(),
          request.auth.token.clientId.upper()
        ])
      ));
    }

    function canReadStation(stationId) {
      return canReadKioskAccess(
        get(/databases/$(database)/documents/kioskAccess/$(stationId)).data
      );
    }

    // Profiles are server-written. A signed-in user can only read their own
    // profile; administrators receive their role through immutable Auth claims.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Account provisioning requests and ownership markers are server-only.
    match /workspaceProvisioning/{uid} {
      allow read, write: if false;
    }

    // Website inquiries and their message history contain customer contact and
    // payment-identification data. Administrators may read them in the support
    // workspace; all writes are validated by Cloud Functions.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Personal staff routing numbers are visible only to administrators and
    // are changed through validated Cloud Functions.
    match /supportTelephonyStaff/{staffId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /supportTelephonyConfig/{configId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Uploaded MP3 prompt metadata is administrator-readable. Audio bytes stay
    // private in Storage and are served through the constrained media function.
    match /supportVoicePrompts/{promptId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Canonical inbound and outbound support call history. The voice webhook is
    // the only writer; administrators can review the log in Customer Service.
    match /supportCallLogs/{callId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ChargeDrops agreements contain immutable contract snapshots, signer
    // evidence, one-time-code hashes, and audit events. Clients and admins use
    // authenticated Cloud Functions so no browser can alter the record trail.
    match /chargeDropsAgreements/{agreementId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    match /chargeDropsAgreementChallenges/{uid} {
      allow read, write: if false;
    }

    // Partner onboarding updates contain recipient addresses and delivery audit
    // state. Only trusted Cloud Functions may create or inspect these records.
    match /chargeDropsPartnerNotifications/{notificationId} {
      allow read, write: if false;
    }

    // Regional partner invitations use hashed one-time tokens. Applicants and
    // admins access them only through validated Cloud Functions.
    match /regionalPartnerOnboardingInvites/{inviteId} {
      allow read, write: if false;
    }

    match /regionalPartnerAgreements/{agreementId} {
      allow read, write: if false;
    }

    match /regionalPartnerAgreementChallenges/{inviteId} {
      allow read, write: if false;
    }

    // Financial records and bank-connection metadata are never exposed to the
    // browser SDK. Admins use Cloud Functions so access is checked and audited
    // server-side. Plaid application secrets belong in Secret Manager, and
    // per-connection tokens must never be returned to the browser.
    match /accounting/{document=**} {
      allow read, write: if false;
    }

    // Dashboard reads are authenticated and scoped to the kiosk relationship
    // encoded in the caller's immutable clientId/role custom claims.
    match /kiosks/{docId} {
      allow read: if request.auth != null && canReadKioskData(resource.data);
      allow write: if false;
    }

    // Station-to-owner projections let rental documents be authorized without
    // assuming that a kiosk document ID is the same as its station ID.
    match /kioskAccess/{stationId} {
      allow read, write: if false;
    }

    match /rentals/{docId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        (resource.data.rentalStationid is string && canReadStation(resource.data.rentalStationid))
      );
      allow write: if false;
    }

    match /rentalDashboardStats/{stationId} {
      allow read: if request.auth != null && (isAdmin() || canReadStation(stationId));
      allow write: if false;
    }

    match /rentalDashboardMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /server/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stations/{stationId}/snapshots/{snapshotId} {
      allow read: if request.auth != null && (isAdmin() || canReadStation(stationId));
      allow write: if false;
    }

    match /kioskEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /kioskIncidents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Managed kiosk phones contain precise location and administrative state.
    // Dashboard clients may only read them as an admin; all writes go through
    // Cloud Functions so commands are validated, confirmed, and signed.
    match /phoneDevices/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /phoneDeviceCommands/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /phoneKioskAssignments/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /phoneDeviceEnrollments/{docId} {
      allow read, write: if false;
    }

    // Payter state is mirrored from the existing Node-RED runtime. Only
    // Chargerent administrators can view it, and all mutations must pass
    // through authenticated Cloud Functions after the bridge is enabled.
    match /payterTerminals/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payterRuntime/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payterUiConfig/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contains terminal serials, callback correlation and frozen profile data.
    // Test sessions are available only through authenticated Cloud Functions.
    match /apolloProfileTests/{docId} {
      allow read, write: if false;
    }

    match /apolloProfileTestLocks/{docId} {
      allow read, write: if false;
    }

    // U.S. Apollo orchestration contains terminal allowlists, immutable releases,
    // callback state, hashed QR credentials, and vend state. Server identities only.
    match /apolloProfileTemplates/{docId} {
      allow read, write: if false;
    }
    match /apolloProfileReleases/{docId} {
      allow read, write: if false;
    }
    match /apolloClientAssignments/{docId} {
      allow read, write: if false;
    }
    match /apolloTerminalRegistry/{docId} {
      allow read, write: if false;
    }
    match /apolloTerminalRuntime/{docId} {
      allow read, write: if false;
    }
    match /apolloQrCredentials/{docId} {
      allow read, write: if false;
    }
    match /apolloRuntimeEvents/{docId} {
      allow read, write: if false;
    }
    match /apolloVendSessions/{docId} {
      allow read, write: if false;
    }
    match /apolloLabRentals/{docId} {
      allow read, write: if false;
    }

    // Login lockout state — public read so LoginPage can check before auth
    // Writes are only via Cloud Functions (Admin SDK bypasses these rules)
    match /loginAttempts/{username} {
      allow read: if true;
      allow write: if false;
    }

    // Public display-only AI booth screen settings. Writes are mirrored by Cloud Functions.
    match /aiBoothScreenUi/{screenUiId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is administrator-readable only. Product-specific access
    // must be granted explicitly above rather than inherited by every account.
    match /{collection}/{document=**} {
      allow read: if isAdmin() &&
        !collection.matches('ctf7.*') &&
        collection != 'workspaceProvisioning' &&
        collection != 'chargeDropsAgreements' &&
        collection != 'chargeDropsAgreementChallenges' &&
        collection != 'chargeDropsPartnerNotifications' &&
        collection != 'regionalPartnerOnboardingInvites' &&
        collection != 'regionalPartnerAgreements' &&
        collection != 'regionalPartnerAgreementChallenges' &&
        collection != 'accounting' &&
        collection != 'phoneDeviceEnrollments' &&
        collection != 'apolloQrCredentials';
      allow write: if false;
    }
  }
}
