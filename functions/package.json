{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test:kiosk-terminal": "node --test kioskTerminal.test.js besiterGateway.test.js",
    "test:phone-control": "node --test phoneControl.test.js",
    "test:chargedrops-agreements": "node --test chargeDropsAgreements.test.js chargeRentClientAgreementTemplate.test.js chargeDropsPartnerNotifications.test.js",
    "test:chargedrops-stripe": "node --test chargeDropsStripeConnect.test.js",
    "test:accounting": "node --test accounting.test.js",
    "backfill:rental-dashboard-stats": "node scripts/backfill-rental-dashboard-stats.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "mqtt": "^5.15.2",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.4.1"
  },
  "private": true
}
